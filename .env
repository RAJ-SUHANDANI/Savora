-- Local development environment. Committed on purpose: it contains no secrets,
-- only the connection string for the PostgreSQL instance that `npm run db:up`
-- creates on your own machine, plus safe development defaults.
--
# --- Database -------------------------------------------------------------
# This points at the local PostgreSQL 18 server started by `npm run db:up`.
# For production, replace it with your Supabase / Railway / Neon URL and set it
# as an environment variable in the hosting dashboard (never in git).
DATABASE_URL="postgresql://savora:savora@127.0.0.1:5433/savora"
SAVORA_PG_PORT=5433

# --- Auth -----------------------------------------------------------------
# A real secret is required in production; this fixed dev value keeps local
# sign-in working with zero setup. Generate a new one with:
#   npx auth secret
AUTH_SECRET="savora-local-development-secret-do-not-use-in-production"
AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ----------------------------------------------
# Leave blank to hide the Google button in the UI. The credentials are free
# from console.cloud.google.com -> APIs & Services -> Credentials.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email ----------------------------------------------------------------
# With no provider configured, Savora writes every message to `.outbox/` as
# .html files and exposes them at /dev/outbox, so you can read the real
# rendered confirmation emails without a paid provider.
RESEND_API_KEY=""
SMTP_URL=""
# Must be a sender address your provider has verified before it will deliver.
EMAIL_FROM="Savora <bookings@savora.example>"

# --- Seeded logins (development only) -------------------------------------
# The seed creates these accounts so the admin dashboard and the customer
# dashboard can both be reviewed immediately after `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@savora.example"
SEED_ADMIN_PASSWORD="savora-admin"
SEED_CUSTOMER_EMAIL="guest@savora.example"
SEED_CUSTOMER_PASSWORD="savora-guest"

# --- Misc -----------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1

# --- Demo mode ------------------------------------------------------------
# Off for local development, so `DATABASE_URL` above is what the app uses.
#
# It is deliberately absent from the deployment's environment too: Next.js only
# fills in variables that are missing from the real process environment, so a
# host that sets DEMO_DB=1 wins over this file. That is what lets one commit
# serve both the local database and the in-process one.
#
# Verify it without touching your local database:
#   npm run check:demo
DEMO_DB=0
