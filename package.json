{
  "name": "savora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check": "tsc --noEmit && eslint src scripts --max-warnings 0 && tsx scripts/check-server-actions.ts",
    "check:actions": "tsx scripts/check-server-actions.ts",
    "check:reservations": "tsx scripts/check-reservation-actions.ts",
    "check:demo": "tsx scripts/check-demo-db.ts",
    "check:credentials": "tsx scripts/check-credentials.ts",
    "build": "npm run check && next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "tsx scripts/local-db.ts up",
    "db:down": "tsx scripts/local-db.ts down",
    "db:status": "tsx scripts/local-db.ts status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:make": "prisma migrate dev",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "verify:constraint": "tsx scripts/verify-constraint.ts",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "audit:overlap": "node scripts/audit-overlap.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "setup": "npm run db:up && npm run db:generate && npm run db:migrate && npm run db:seed && npm run verify:constraint",
    "cron": "tsx scripts/run-cron.ts",
    "rate-limits:reset": "tsx scripts/reset-rate-limits.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@electric-sql/pglite": "^0.5.8",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "framer-motion": "^13.4.6",
    "lucide-react": "^0.548.0",
    "next": "16.3.7",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
