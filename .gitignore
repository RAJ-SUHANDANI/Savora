.next/
out/
build/
.DS_Store
*.pem
npm-debug.log*
# `.env` is committed deliberately: it holds only the local PostgreSQL
# connection string and development defaults, with no real secrets. Production
# secrets are set as environment variables in the hosting dashboard.
#!*.env*
.env.production
.env.local
.vercel
*.tsbuildinfo
next-env.d.ts

# Local PostgreSQL cluster managed by scripts/local-db.ts
.postgres-data/

# Demo-mode database (PGlite, a real PostgreSQL compiled to WebAssembly).
# Rebuilt from the migrations and the seed on demand — delete it and restart.
.pglite/
.pglite-*/

# Audit output and the local outbox (regenerated by npm run audit:* / dev)
.audit/
.outbox/
.audit-*.txt
