# -----------------------------------------------------------------------------
# Savora — environment
#
# Copy to `.env` for local development. Every value here is a development
# default with no real secret in it, which is why `.env` is committed. Anything
# sensitive belongs in your host's dashboard, not in this file.
# -----------------------------------------------------------------------------

# The local database started by `npm run db:up` (real PostgreSQL, no Docker).
DATABASE_URL=postgresql://savora:savora@127.0.0.1:5433/savora

# NextAuth. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leaving this unset makes sign-in fail in development; the value below is a
# throwaway string that exists only so the app boots.
AUTH_SECRET=dev-only-insecure-secret-change-me
AUTH_TRUST_HOST=true

# The site's IANA zone. This is data, not a constant — it is what turns the
# wall-clock opening hours into real instants. See AGENTS.md.
# (Read from RestaurantSettings.timezone at runtime; this is only the fallback.)

# Demo mode. When `1`, the app runs against an in-process PostgreSQL (PGlite)
# instead of the URL above, creating and seeding itself on first request. It is
# how the Vercel preview deploys without a database attached. Set to `0` or omit
# for real local development.
#
# PGlite is single-connection and stores to a directory, so it suits a demo or a
# preview environment and nothing else. Point DATABASE_URL at a real server to
# use a real database; no code changes are needed.
DEMO_DB=0

# Guards /api/cron/reminders. When unset, that route requires an admin session
# instead, which is the safer default for a demo deployment.
# CRON_SECRET=
